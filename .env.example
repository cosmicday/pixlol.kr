# pixlol.kr — 환경변수 이름표 (실제 값은 .env 에만 둔다. .env 는 .gitignore 로 막혀 있다)
# Railway 에서는 Variables 에 같은 이름으로 넣는다

# ---- 필수 ----
API_KEY=                 # 라이엇 API 키 (RGAPI-…). 전적검색·랭킹·순회·티어 조회 전부
MONGO_URI=               # MongoDB Atlas 연결 문자열 (mongodb+srv://…)

# ---- 방송 탭 (없는 플랫폼은 조용히 빠진다) ----
SOOP_CLIENT_ID=          # SOOP Developers (방송 리스트·카테고리 리스트)
SOOP_CLIENT_SECRET=      # 지금 코드는 안 쓴다
CHZZK_CLIENT_ID=         # 치지직 개발자센터 (공식 API 폴백용)
CHZZK_CLIENT_SECRET=
YOUTUBE_API_KEY=         # Google Cloud — YouTube Data API v3 (방송 확인 videos.list). InnerTube 후보 수집은 키가 필요 없다

# ---- 신화상점 수집기 ----
COLLECTOR_TOKEN=         # 로컬 수집기 → POST /api/mythic-shop 인증 토큰

# ---- 선택 (프로덕션) ----
ORIGIN_GUARD=            # Cloudflare Transform Rule 과 맞추는 오리진 잠금 비밀값. 없으면 잠금 꺼짐 (docs 참고 — Railway 에 넣기 전에 CF 룰 먼저)
NODE_ENV=                # production
PORT=                    # Railway 가 넣어 준다

# ---- 선택 (운영 손잡이 · 로컬 실험) ----
# READONLY_JOBS=1        # 잡 안 띄우고 조회만 (로컬)
# BROADCAST_SCHEDULE=1   # READONLY_JOBS 에서도 방송 정시 수집을 돌린다 (유튜브 할당량을 같이 먹는다)
# REBUILD_STATS=1        # 집계만 한 번
# STATS_UNFREEZE=        # 닫힌 패치 재집계
# APP_LIMIT_GUARD=80     # 라이엇 2분 예산 가드
# SCAN_PER_CYCLE= / SCAN_PER_CYCLE_MAX= / SCAN_FINISH_MARGIN_MIN=
# STAT_TIGHT_MB=400 / STAT_CHUNKS=4 / VERSUS_RATE_MAX=12 / COLLECTOR_RATE_MAX=
# RESCAN_DAY= / RESCAN_LIMIT= / RESCAN_GAP=   BACKFILL_TL=1 / BACKFILL_ALL= / BACKFILL_LIMIT= / BACKFILL_GAP=
# DD_VER=16.16.1         # 빌드 스크립트에 옛 버전을 강제할 때
